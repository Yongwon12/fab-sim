{
  "name": "fab-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Semiconductor fab equipment simulator: one unified equipment UI, trace/ERD generation, EES/FDC/QMS/AMS",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/main.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.20.6",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
